TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_USER_ID=replace_with_your_numeric_telegram_user_id

# DSM HTTPS 주소: 컨테이너에서 접근 가능하고 인증서가 유효한 주소
DSM_URL=https://nas.example.com:5001
DSM_ACCOUNT=dedicated_bot_account
DSM_PASSWORD=replace_with_dsm_password
# File Station 경로. 호스트 /volume4 접두사는 제외
DSM_DOWNLOADS_PATH=/docker/hoho_ytdl_bot/data/telegram
